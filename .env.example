# ==============================================================================
# JARVIS — Environment Variables Template
# Copy this file to .env and adjust values as needed.
# NEVER commit .env with secrets or credentials to version control.
# ==============================================================================

# System environment (development, production, testing)
JARVIS_ENV=development

# Operating mode (default: terminal)
JARVIS_MODE=terminal

# Debug mode (true / false)
JARVIS_DEBUG=false

# Logging verbosity (DEBUG, INFO, WARNING, ERROR, CRITICAL)
JARVIS_LOG_LEVEL=INFO

# Model configuration
JARVIS_MODEL_PROVIDER=mock
JARVIS_MODEL_NAME=llama3.2
JARVIS_MODEL_BASE_URL=http://localhost:11434
JARVIS_MODEL_TEMPERATURE=0.7
JARVIS_MODEL_FALLBACK=true
